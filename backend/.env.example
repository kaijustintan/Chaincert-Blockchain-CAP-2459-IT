# ChainCert backend env — template.
# On the VM this lives at ~/chaincert-api/.env  (created by you, NOT committed).
# Copy to .env and fill in. deploy-sync.sh never overwrites the real .env.

# --- Required ---
# App refuses to boot if empty. Generate: openssl rand -hex 48
JWT_SECRET=

# --- Deployment URLs ---
# Local dev: leave the localhost defaults. VM: set both to the public site.
CORS_ORIGIN=http://localhost:3000          # VM -> http://ccscloud.dlsu.edu.ph:20173
FRONTEND_URL=http://localhost:3000         # VM -> http://ccscloud.dlsu.edu.ph:20173  (used in emailed share links)

# --- Data layer ---
# Honored by couchDB_service.js AND by the controllers (M11 complete): change here to move the
# admin CouchDB or rotate its credentials without touching code. Falls back to this default if
# unset. NOTE: `admin:adminpw` is the stock CouchDB development credential — override it for any
# deployment that is reachable by anyone other than you.
COUCHDB_URL=http://admin:adminpw@localhost:5985

# --- Email (Phase 5.5) ---
SMTP_USER=
SMTP_APP_PASSWORD=
# DEMO catch-all for the fake issuer/admin addresses. UNSET in a real deployment
# so every email goes to its true recipient.
SMTP_OVERRIDE_TO=

# =============================================================================================
# --- Testing toggles — MUST be removed/unset for demo & production ---
#
# This list is COMPLETE. It previously showed only the first two, which made it look exhaustive
# while three others existed in code — an operator had no way to learn they were there, and
# therefore no way to confirm they were off.
#
# Every toggle below prints a loud warning at startup when active, and the server logs a single
# summary line on boot:
#     "🔒 Security toggles: none active (production-safe)."   <- what you want to see
#     "🔓 Security toggles ACTIVE (n): ... — NOT production-safe."
# =============================================================================================

# Bypasses the per-IP limiter on login / forgot-password / reset / OTP endpoints.
# DISABLE_RATE_LIMIT=true

# Bypasses the minimum-length + common-password blocklist at every set-password point.
# DISABLE_PASSWORD_POLICY=true

# Bypasses email-ownership proof at signup. Accounts can be created with unverified addresses.
# DISABLE_SIGNUP_OTP=true

# Freezes the admin issuer enable/disable controls (UAT, so testers cannot lock out an account).
# DISABLE_ISSUER_TOGGLE=true

# Allows issuing credentials with a past or same-day expiry date. These land on an IMMUTABLE
# ledger already expired, and an expired credential can never be revoked — so the bad record is
# permanent and cannot even be withdrawn. Testing only.
# ALLOW_PAST_EXPIRY=true

# =============================================================================================
# FRONTEND toggles (set in .env.production / .env.development, NOT here — they are baked into
# the bundle at build time and are PUBLIC). Listed for completeness because both weaken behavior
# and neither was documented anywhere:
#   REACT_APP_ALLOW_PAST_EXPIRY=true      # drops the date-picker lower bound (pairs with ALLOW_PAST_EXPIRY)
#   REACT_APP_DISABLE_ISSUER_TOGGLE=true  # hides the issuer enable/disable UI (pairs with DISABLE_ISSUER_TOGGLE)
# Setting one side without the other yields a UI that offers a control the API refuses, or vice versa.
# =============================================================================================
