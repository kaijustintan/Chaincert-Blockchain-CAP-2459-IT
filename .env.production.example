# ChainCert FRONTEND production build — template.
# On the VM, copy to .env.production in the source clone, then `npm run build`.
# CRA bakes REACT_APP_* into the build AT BUILD TIME. Never put secrets here.

# Backend API base. On the VM use a RELATIVE path so Nginx proxies it
# (same-origin -> no CORS). Local dev defaults to http://localhost:4000/api when unset.
REACT_APP_API_URL=/api

# Public site base (absolute) — used for the QR code embedded in exported credential PDFs.
REACT_APP_FRONTEND_URL=http://ccscloud.dlsu.edu.ph:20173
