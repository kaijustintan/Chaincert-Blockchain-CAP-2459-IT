# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production
.env.production.local
backend/.env

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Backend specific
backend/node_modules/
backend/wallet/
backend/connection-*.json
# also ignore connection profiles nested deeper (e.g. node_creation/dlsu/) — they can carry TLS material
**/connection-*.json
# ...EXCEPT the one hand-written multi-org profile, which is a required build input:
# deploy-sync.sh copies it into fabric-samples and sed-patches its paths for the local $HOME.
# Untracking it would break a fresh clone's deploy. It is safe to track because it references TLS
# certs by FILESYSTEM PATH and embeds no `pem` block — verified. If anyone ever regenerates this
# file in the inline-cert form that Fabric also supports, DELETE THIS EXCEPTION: the rule above is
# what stops embedded TLS material from being committed.
!backend/node_creation/dlsu/connection-delasalleuniversity.json
backend/*.tar.gz
backend/*.backup

# Chaincode specific
chaincode/node_modules/
chaincode/*.tar.gz

# Local-only: UAT raw data + tester PII + draft paper chapters — not for GitHub
docs/submission/cap2/uat/
docs/submission/cap2/final-document/
# Defense form (full names of 4 students + 3 faculty, numeric grade), raw defense
# transcript (verbatim panelist remarks), and the revision working notes derived from them.
docs/submission/cap2/defense-revisions/

# ==========================================================================================
# Added in the pre-publication security pass.
# NOTE: .gitignore only prevents FUTURE commits. Anything already tracked stays tracked until
# `git rm --cached` runs, and stays in history regardless — see LIMITATIONS.md.
# ==========================================================================================

# ── Environment ──
# A bare `.env` was previously uncovered (only .env.local / .env.production / backend/.env were
# listed), so a real secret dropped into the root .env would have been committed silently.
# The three files below are intentionally tracked: they hold non-secret local defaults + templates.
.env
.env.*
!.env.development
!.env.production.example
!backend/.env.example

# ── Secrets & crypto material (Fabric MSP / TLS / wallets) ──
*.pem
*.key
*.crt
*.cer
*.csr
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
*.gpg
**/wallet/
**/organizations/
**/crypto-config/
**/channel-artifacts/
*.block
*.tx

# ── Dependencies & build output (generalize the anchored rules above) ──
node_modules/
dist/
/out
.eslintcache
.cache/
*.tsbuildinfo

# ── Logs ──
*.log
logs/
pnpm-debug.log*
lerna-debug.log*

# ── Test / coverage ──
*.lcov
.nyc_output/

# ── Editors & IDEs ──
.vscode/
!.vscode/extensions.json
.idea/
*.iml
*.swp
*.swo
*~
.history/

# ── OS cruft ──
.DS_Store
.DS_Store?
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

