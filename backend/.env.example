# ChainCert backend env — template.
# On the VM this lives at ~/chaincert-api/.env  (created by you, NOT committed).
# Copy to .env and fill in. deploy-sync.sh never overwrites the real .env.

# --- Required ---
# App refuses to boot if empty. Generate: openssl rand -hex 48
JWT_SECRET=

# --- Deployment URLs ---
# Local dev: leave the localhost defaults. VM: set both to the public site.
CORS_ORIGIN=http://localhost:3000          # VM -> http://ccscloud.dlsu.edu.ph:20173
FRONTEND_URL=http://localhost:3000         # VM -> http://ccscloud.dlsu.edu.ph:20173  (used in emailed share links)

# --- Data layer ---
# Honored by couchDB_service.js (M11 partial): change here to move the admin CouchDB
# or rotate its credentials without touching code. Falls back to this default if unset.
COUCHDB_URL=http://admin:adminpw@localhost:5985

# --- Email (Phase 5.5) ---
SMTP_USER=
SMTP_APP_PASSWORD=
# DEMO catch-all for the fake issuer/admin addresses. UNSET in a real deployment
# so every email goes to its true recipient.
SMTP_OVERRIDE_TO=

# --- Testing toggles — MUST be removed/unset for demo & production ---
# DISABLE_RATE_LIMIT=true
# DISABLE_PASSWORD_POLICY=true
