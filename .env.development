# ChainCert FRONTEND — LOCAL development (Windows `npm start` + WSL backend).
# CRA auto-loads this file on `npm start` ONLY. It does not affect `npm run build`
# (that reads .env.production — see .env.production.example for the VM values).
# Both values match the code defaults in axiosInstance.js / pdfExportService.js;
# they are set explicitly here so the local config is documented, not implicit.

# Absolute (NOT "/api") because local dev has no Nginx proxy: CRA serves :3000 and
# the Express API is a separate origin on :4000. "/api" would 404 against :3000.
REACT_APP_API_URL=http://localhost:4000/api

# Public site base — used for the QR link embedded in exported credential PDFs.
REACT_APP_FRONTEND_URL=http://localhost:3000
